pipeline{
    agent any
    triggers {
  githubPush()
 }
 options {
  buildDiscarder logRotator(daysToKeepStr: '4', numToKeepStr: '5')
  disableConcurrentBuilds()
  timeout(10)
}

    environment{
        SONARQUBE_URL = "http://44.212.19.175:9000"
        SONARQUBE_TOKEN = credentials ('sonarced')
        TOMCAT_SERVER_IP = "172.31.72.241"
      }
    tools {
  maven 'maven-3.9.0'
}
stages {
  stage('git clone') {
    steps {
        git branch: 'main', credentialsId: 'gihub-cred', url: 'https://github.com/resh153/student-reg-webapp.git'
    }
  }
  stage('mvn clean package') {
    steps {
        sh "mvn clean package"
    }
  }
  stage('sonar scan') {
    steps {
        sh "mvn clean verify -Dsonar.token={SONARQUBE_TOKEN}"
        }
    }
    stage('upload war to nexus') {
    steps {
        sh "mvn clean deploy"
        }
    }
    stage('deploy  to devserver') {
        when {
          expression {
            return env.BRANCH_NAME == 'development'
          }
        }
        steps {
            sshagent(['tomcat_server']) {
                sh """
                ssh -o StrictHostKeyChecking=no ec2-user@${TOMCAT_SERVER_IP} "sudo systemctl stop tomcat"
                echo "stopping tomcat process"
                sleep 30
             scp -o StrictHostKeyChecking=no target/student-reg-webapp.war ec2-user@${TOMCAT_SERVER_IP}:/opt/tomcat/webapps/student-reg-webapp.war
             ssh -o StrictHostKeyChecking=no ec2-user@${TOMCAT_SERVER_IP} "sudo systemctl start tomcat"
             echo "starting tomcat process"
             """
        }
    }
    }
  }
  post {
    always {
      cleanWs()
  }
      
  success {
      slackSend (channel: 'lic-app', color: "good", message: "Build - SUCCESS : ${env.JOB_NAME} #${env.BUILD_NUMBER} - URL: ${env.BUILD_URL}")
          sendEmail(
           "${env.JOB_NAME} - ${env.BUILD_NUMBER} - Build SUCCESS",
           "Build SUCCESS. Please check the console output at ${env.BUILD_URL}",
           'shahabsk135@gmail.com' )
    
  }
  failure {
      slackSend (channel: 'lic-app', color: "good", message: "Build - SUCCESS : ${env.JOB_NAME} #${env.BUILD_NUMBER} - URL: ${env.BUILD_URL}")
          sendEmail(
           "${env.JOB_NAME} - ${env.BUILD_NUMBER} - Build failed",
           "Build SUCCESS. Please check the console output at ${env.BUILD_URL}",
           'shahabsk135@gmail.com' )
  }
  }
}  
  def sendEmail(String subject, String body, String recipient) {
    emailext(
        subject: subject,
        body: body,
        to: recipient,
        mimeType: 'text/html'
    )
}